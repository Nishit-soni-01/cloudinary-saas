
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Video {
  id             String   @id @default(cuid())
  userId         String
  title          String
  description    String?
  publicId       String   @unique
  originalSize   Int
  compressedSize Int
  duration       Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model Image {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  publicId  String   @unique
  format    String?
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model UserPreference {
  id                             String   @id @default(cuid())
  userId                         String   @unique

  theme                          String   @default("dark")

  uploadNotifications            Boolean  @default(true)
  processingNotifications        Boolean  @default(true)
  backgroundRemovalNotifications Boolean  @default(true)
  securityNotifications           Boolean  @default(true)

  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String

  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}
